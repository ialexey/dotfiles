#!/usr/bin/env python3
# Slack desktop drops many dunst notification clicks, so on every click also
# open the notified message via a slack:// deep link.

import fcntl
import json
import os
import re
import subprocess
import sys
import threading
import time
from datetime import datetime

LOG_DIR = os.path.expanduser("~/.config/Slack/logs/default")
TAIL_BYTES = 3 * 1024 * 1024
LOG = os.path.expanduser("~/.cache/slack-notify-click.log")

HEADER = re.compile(r"^(method call|method return|signal|error) time=([\d.]+) sender=(\S+) -> destination=(\S+) serial=(\d+)(?: reply_serial=(\d+))?")
STORE = re.compile(r"^\[(\d\d/\d\d/\d\d, \d\d:\d\d:\d\d):(\d{3})\] info: Store: (NEW)_NOTIFICATION \{")


def read_log_tail():
    text = ""
    for name in ("webapp-console1.log", "webapp-console.log"):
        path = os.path.join(LOG_DIR, name)
        try:
            with open(path, "rb") as f:
                f.seek(0, os.SEEK_END)
                f.seek(max(0, f.tell() - TAIL_BYTES))
                text += f.read().decode("utf-8", "replace") + "\n"
        except OSError:
            pass
    return text


def store_events(text):
    lines = text.splitlines()
    i = 0
    while i < len(lines):
        m = STORE.match(lines[i])
        i += 1
        if not m:
            continue
        body = ["{"]
        while i < len(lines) and not lines[i].startswith("}"):
            body.append(lines[i])
            i += 1
        body.append("}")
        try:
            data = json.loads("\n".join(body))
        except ValueError:
            continue
        ts = datetime.strptime(m.group(1), "%m/%d/%y, %H:%M:%S").timestamp() + int(m.group(2)) / 1000
        yield m.group(3), ts, data


def find_notification(shown_at):
    best = None
    for kind, ts, data in store_events(read_log_tail()):
        if kind == "NEW" and abs(ts - shown_at) < 2 and (best is None or abs(ts - shown_at) < abs(best[0] - shown_at)):
            best = (ts, data)
    return best[1] if best else None


def log(msg):
    with open(LOG, "a") as f:
        f.write(f"{time.strftime('%F %T')} {msg}\n")


def on_click(shown_at):
    notif = find_notification(shown_at)
    if not notif or not re.match(r"^[CDG]", notif.get("channel", "")):
        log("click: no matching Slack message, skipped")
        return
    url = f"slack://channel?team={notif['teamId']}&id={notif['channel']}&message={notif['msg']}"
    if notif.get("thread_ts"):
        url += f"&thread_ts={notif['thread_ts']}"
    subprocess.Popen(["/usr/bin/slack", "--gtk-version=3", "-s", url],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    log(f"click: opened {url}")


def main():
    lock = open(os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "slack-notify-click.lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        sys.exit("already running")

    mon = subprocess.Popen(
        ["dbus-monitor", "--session",
         "type='method_call',interface='org.freedesktop.Notifications',member='Notify'",
         "type='method_return',sender='org.freedesktop.Notifications'",
         "type='signal',interface='org.freedesktop.Notifications',member='ActionInvoked'"],
        stdout=subprocess.PIPE, text=True)

    pending = {}  # (sender, serial) -> time, for Notify calls from Slack
    shown = {}    # notification id -> time shown
    cur, args = None, []

    # Returns True once the message has been fully dealt with, so a click is
    # acted on as soon as its arguments arrive rather than at the next message.
    def handle():
        kind, t, sender, dest, serial, reply = cur
        if kind == "method call":
            if args[0] == 'string "Slack"':
                pending[(sender, serial)] = t
            return True
        if kind == "method return":
            if (dest, reply) in pending and args[0].startswith("uint32 "):
                shown[int(args[0].split()[1])] = pending.pop((dest, reply))
            return True
        if kind == "signal" and len(args) >= 2:
            nid = int(args[0].split()[1])
            if args[1] == 'string "default"' and nid in shown:
                threading.Thread(target=on_click, args=(shown.pop(nid),), daemon=True).start()
            return True
        return kind != "signal"

    for line in mon.stdout:
        m = HEADER.match(line)
        if m:
            cur = (m.group(1), float(m.group(2)), m.group(3), m.group(4), m.group(5), m.group(6))
            args = []
        elif cur and line.startswith("   ") and not line.startswith("    "):
            args.append(line.strip())
            if handle():
                cur = None
                for d in (pending, shown):
                    if len(d) > 200:
                        for k in list(d)[:100]:
                            del d[k]


if __name__ == "__main__":
    main()
