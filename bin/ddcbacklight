#!/bin/bash

CACHE_FILE="/tmp/ddcutil_brightness"

# Read cached value or fetch if missing
if [[ -f "$CACHE_FILE" ]]; then
    a=$(cat "$CACHE_FILE")
else
    a=$(sudo ddcutil getvcp 10 -t 2>/dev/null | awk '{print $4}')
    [[ -n "$a" ]] && echo "$a" > "$CACHE_FILE"
fi

# If no argument, just print current value
if [[ -z "$1" ]]; then
    echo $a
    exit 0
fi

# Apply delta
a=$((a + $1))

# Clamp to 0-100
((a < 0)) && a=0
((a > 100)) && a=100

# Set and cache
sudo ddcutil setvcp 10 $a > /dev/null && echo $a > "$CACHE_FILE"
echo $a
